APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:{{ base64(43) }}
APP_DEBUG=false
APP_URL=https://{{ hostname() }}

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST={{ private_ip() }}
DB_PORT=3306
DB_DATABASE=app_production
DB_USERNAME=app_user
DB_PASSWORD={{ password(24) }}

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST={{ private_ip() }}
REDIS_PASSWORD={{ password(20) }}
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.{{ hostname() }}
MAIL_PORT=587
MAIL_USERNAME={{ email() }}
MAIL_PASSWORD={{ password(16) }}
MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID={{ aws_access_key() }}
AWS_SECRET_ACCESS_KEY={{ base64(40) }}
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=app-production-assets

JWT_SECRET={{ hex(64) }}
STRIPE_KEY=pk_live_{{ hex(24) }}
STRIPE_SECRET=sk_live_{{ hex(24) }}
