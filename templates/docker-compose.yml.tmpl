version: "3.8"

services:
  app:
    image: internal-registry.{{ hostname() }}/app:latest
    restart: unless-stopped
    ports:
      - "8080:8080"
    environment:
      DATABASE_URL: "postgres://app_admin:{{ password(24) }}@{{ private_ip() }}:5432/app_production"
      REDIS_URL: "redis://:{{ password(20) }}@{{ private_ip() }}:6379/0"
      JWT_SECRET: "{{ hex(48) }}"
      AWS_ACCESS_KEY_ID: "{{ aws_access_key() }}"
      AWS_SECRET_ACCESS_KEY: "{{ base64(40) }}"
      SMTP_USER: "{{ email() }}"
      SMTP_PASSWORD: "{{ password(16) }}"
    depends_on:
      - db
      - redis

  db:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_USER: app_admin
      POSTGRES_PASSWORD: "{{ password(24) }}"
      POSTGRES_DB: app_production
    volumes:
      - db-data:/var/lib/postgresql/data

  redis:
    image: redis:7
    restart: unless-stopped
    command: ["redis-server", "--requirepass", "{{ password(20) }}"]

volumes:
  db-data:
